# ============================================================
# Full Contabo VPS production environment
# Frontend + API + WebSocket + worker + PostgreSQL all run on VPS.
# Replace every placeholder before production deployment.
# Never commit the real .env file.
# ============================================================

# Public same-origin application
PUBLIC_ORIGIN=https://derivadmin.site
FRONTEND_HOSTING_MODE=vps
DASHBOARD_FRONTEND_ORIGINS=https://derivadmin.site,https://www.derivadmin.site
# Independent HMAC key for short-lived realtime tickets. Generate a strong random value.
DASHBOARD_STREAM_SIGNING_KEY=replace_with_a_long_random_realtime_signing_key

# PostgreSQL
POSTGRES_DB=underdog_test2
POSTGRES_USER=underdog
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Deriv application identity
DERIV_APP_ID=replace_with_registered_deriv_app_id
DERIV_OAUTH_CLIENT_ID=replace_with_the_same_registered_deriv_app_id
# OAuth is same-origin and Nginx proxies /oauth/* to the API container.
DERIV_OAUTH_REDIRECT_URL=https://derivadmin.site/oauth/callback
DERIV_OAUTH_SCOPES="trade application_read"
DERIV_APP_MARKUP_PERCENTAGE=3.0
DERIV_PUBLIC_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public
DERIV_REST_BASE_URL=https://api.derivws.com
DERIV_ENVIRONMENT=demo
# Fresh deployments start with financial execution disabled. Enable only after
# API/OAuth/WSS health checks are complete, then perform Demo acceptance.
DERIV_TRADING_ENABLED=false

# Secrets - generate new independent values
DERIV_TOKEN_ENCRYPTION_KEY=replace_with_a_valid_fernet_key
CONTROL_API_KEY=replace_with_a_long_random_control_api_key

# Browser/API security
SESSION_COOKIE_SECURE=true
CLIENT_SESSION_SAMESITE=lax
CLIENT_SESSION_COOKIE_DOMAIN=
# Host Nginx preserves the public Host header when proxying to the API.
TRUSTED_HOSTS=derivadmin.site,www.derivadmin.site,127.0.0.1,localhost,api
CORS_ALLOWED_ORIGINS=https://derivadmin.site,https://www.derivadmin.site
PUBLIC_DASHBOARD_READ_ONLY=true

# Demo and Real paths exist, but Real stays disabled until Demo acceptance passes.
TRADING_MODE=demo
ALLOW_REAL_TRADING=false
PRODUCTION_ACKNOWLEDGEMENT=I_ACKNOWLEDGE_REAL_MONEY_TRADING

# Current account-scoped virtual protection policy. Keep aligned with the Builder.
VIRTUAL_PROTECTION_ENABLED=true
VIRTUAL_TRIGGER_ACTUAL_LOSSES=2
VIRTUAL_EXIT_AFTER_WINS=1

# Disable old token-file execution. Users link accounts through OAuth.
ALLOW_LEGACY_GLOBAL_TOKENS=false

# Account/session refresh. Financial execution itself is WebSocket-driven.
ACCOUNT_REFRESH_INTERVAL_SECONDS=10

# Private account WebSocket startup/reconnect protection
PRIVATE_WS_CONNECT_INTERVAL_SECONDS=0.35
PRIVATE_WS_HANDSHAKE_CONCURRENCY=2
PRIVATE_WS_RATE_LIMIT_BACKOFF_SECONDS=60
PRIVATE_WS_MAX_BACKOFF_SECONDS=300
PRIVATE_WS_RECONNECT_JITTER_SECONDS=1.0
PRIVATE_WS_OTP_FAILURE_BACKOFF_SECONDS=5.0
# Proposal/buy request-response wait on an already-connected private session.
# An uncertain BUY timeout is never automatically retried.
PRIVATE_WS_REQUEST_TIMEOUT_SECONDS=4.0

# Public market stream: intentional market-subscription changes reconnect quickly;
# actual provider/network failures still use bounded exponential/rate-limit backoff.
DERIV_PUBLIC_WS_PLANNED_RESTART_SECONDS=0.35
DERIV_PUBLIC_WS_BACKOFF_BASE_SECONDS=15
DERIV_PUBLIC_WS_BACKOFF_MAX_SECONDS=300
DERIV_PUBLIC_WS_RATE_LIMIT_BACKOFF_SECONDS=300
DERIV_PUBLIC_WS_JITTER_SECONDS=5

# Worker-to-API realtime wake-up. Docker Compose supplies the internal URL.
# CONTROL_API_KEY authenticates this call. Financial settlement never waits for it.

# Optional Telegram reporting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Diagnostics: keep high-frequency logs off in normal production.
LIVE_TICK_LOG_LINES=false
EVERY_TICK_LOGS=false
LOG_JSON=false
