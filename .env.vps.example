# PostgreSQL - replace every placeholder before deployment
POSTGRES_DB=underdog_test2
POSTGRES_USER=underdog
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Deriv application identity
DERIV_APP_ID=replace_with_registered_deriv_app_id
DERIV_OAUTH_CLIENT_ID=replace_with_the_same_registered_deriv_app_id
DERIV_OAUTH_REDIRECT_URL=https://derivadmin.site/oauth/callback
DERIV_OAUTH_SCOPES="trade application_read"
DERIV_APP_MARKUP_PERCENTAGE=3.0
DERIV_PUBLIC_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public
DERIV_REST_BASE_URL=https://api.derivws.com
DERIV_ENVIRONMENT=demo
DERIV_TRADING_ENABLED=true

# Secrets - generate new independent values; never commit the real .env file
DERIV_TOKEN_ENCRYPTION_KEY=replace_with_a_valid_fernet_key
CONTROL_API_KEY=replace_with_a_long_random_control_api_key

# Browser/API security
SESSION_COOKIE_SECURE=true
TRUSTED_HOSTS=derivadmin.site,www.derivadmin.site,127.0.0.1,localhost,api
CORS_ALLOWED_ORIGINS=https://derivadmin.site,https://www.derivadmin.site
PUBLIC_DASHBOARD_READ_ONLY=true

# Demo and Real are both supported. Real execution requires these explicit switches.
# Keep DERIV_ENVIRONMENT=demo so the platform still defaults to Demo when no account type is selected.
TRADING_MODE=demo
ALLOW_REAL_TRADING=true
PRODUCTION_ACKNOWLEDGEMENT=I_ACKNOWLEDGE_REAL_MONEY_TRADING

# Production recovery policy:
# OVER-2 real loss -> real PUT.
# Real PUT win -> back to OVER-2.
# Real PUT loss -> virtual PUT mode until 2 consecutive virtual PUT wins.
# After 2 virtual PUT wins -> next qualifying PUT is real again.
VIRTUAL_PROTECTION_ENABLED=true
VIRTUAL_TRIGGER_ACTUAL_LOSSES=2
VIRTUAL_EXIT_AFTER_WINS=1

# Disable old token-file execution. Users link accounts through the application.
ALLOW_LEGACY_GLOBAL_TOKENS=false

# Worker-to-API update channel
ACCOUNT_REFRESH_INTERVAL_SECONDS=10

# Private account WebSocket startup/reconnect protection
PRIVATE_WS_CONNECT_INTERVAL_SECONDS=0.75
PRIVATE_WS_HANDSHAKE_CONCURRENCY=2
PRIVATE_WS_RATE_LIMIT_BACKOFF_SECONDS=60
PRIVATE_WS_MAX_BACKOFF_SECONDS=300
PRIVATE_WS_RECONNECT_JITTER_SECONDS=3
PRIVATE_WS_OTP_FAILURE_BACKOFF_SECONDS=15

# Optional Telegram reporting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional diagnostics
LIVE_TICK_LOG_LINES=true
EVERY_TICK_LOGS=false
LOG_JSON=false
