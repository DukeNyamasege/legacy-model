FROM node:22-alpine AS build

WORKDIR /app

COPY package.json ./
RUN npm install --ignore-scripts --no-audit --no-fund

COPY dashboard ./dashboard
COPY scripts/build-vps.mjs ./scripts/build-vps.mjs
COPY scripts/export-deriv-quill-icons-v2.mjs ./scripts/export-deriv-quill-icons-v2.mjs

ARG PUBLIC_ORIGIN=https://derivadmin.site
ARG PUBLIC_TESTING_FREE_ACCESS=true
ENV PUBLIC_ORIGIN=${PUBLIC_ORIGIN}
ENV PUBLIC_TESTING_FREE_ACCESS=${PUBLIC_TESTING_FREE_ACCESS}

RUN node scripts/build-vps.mjs
# Full-VPS hotfix controller is intentionally injected after the canonical build.
# It removes the duplicate page-level Run controls, keeps one Start/Stop authority,
# and suppresses raw transport timeout text while the backend reconnects/retries.
RUN cp dashboard/single-run-controller-v1.js dist/single-run-controller-v1.js \
  && node -e "const fs=require('fs');const p='dist/index.html';let h=fs.readFileSync(p,'utf8');const s='<script src=\"/single-run-controller-v1.js?v=20260818-single-run-v1\" defer></script>';if(!h.includes(s))h=h.replace('</body>',s+'\\n</body>');fs.writeFileSync(p,h);"

FROM nginx:1.27-alpine AS frontend

COPY deploy/nginx/frontend-container.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=12 \
  CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
