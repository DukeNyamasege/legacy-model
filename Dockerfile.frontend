FROM node:22-alpine AS build

WORKDIR /app

COPY package.json ./
RUN npm install --ignore-scripts --no-audit --no-fund

COPY dashboard ./dashboard
COPY scripts/build-vps.mjs ./scripts/build-vps.mjs
COPY scripts/build-direct-runtime-v2.mjs ./scripts/build-direct-runtime-v2.mjs
COPY scripts/finalize-direct-runtime-v2.mjs ./scripts/finalize-direct-runtime-v2.mjs
COPY scripts/finalize-direct-ux-v4.mjs ./scripts/finalize-direct-ux-v4.mjs
COPY scripts/finalize-production-controls-v6.mjs ./scripts/finalize-production-controls-v6.mjs
COPY scripts/finalize-production-controls-v6b.mjs ./scripts/finalize-production-controls-v6b.mjs
COPY scripts/finalize-scheduler-v2.mjs ./scripts/finalize-scheduler-v2.mjs
COPY scripts/export-deriv-quill-icons-v2.mjs ./scripts/export-deriv-quill-icons-v2.mjs

ARG PUBLIC_ORIGIN=https://derivadmin.site
ARG PUBLIC_TESTING_FREE_ACCESS=true
ENV PUBLIC_ORIGIN=${PUBLIC_ORIGIN}
ENV PUBLIC_TESTING_FREE_ACCESS=${PUBLIC_TESTING_FREE_ACCESS}

RUN node scripts/build-vps.mjs
RUN node scripts/build-direct-runtime-v2.mjs \
  && node scripts/finalize-direct-runtime-v2.mjs \
  && node scripts/finalize-direct-ux-v4.mjs \
  && node scripts/finalize-production-controls-v6.mjs \
  && node scripts/finalize-production-controls-v6b.mjs \
  && node --check dist/final-premium-6f3.js \
  && node --check dist/final-ui-shell-v2.js \
  && node --check dist/deriv-direct-execution-v2.js \
  && node --check dist/direct-runtime-ux-v4.js

# Hybrid execution frontend: browser-direct manual trading and server-owned durable
# scheduling remain separate financial authorities. unified-ledger-v9 merges both
# contract sources and keeps them until Reset. Scheduler-v2 finalizes exact seconds,
# future-only admission, history/result cards and one-second server-start visibility.
RUN cp dashboard/direct-pip-precision-v1.js dist/direct-pip-precision-v1.js \
  && cp dashboard/direct-financial-fence-v1.js dist/direct-financial-fence-v1.js \
  && cp dashboard/direct-socket-control-v1.js dist/direct-socket-control-v1.js \
  && cp dashboard/direct-hard-stop-fence-v1.js dist/direct-hard-stop-fence-v1.js \
  && cp dashboard/direct-reset-authority-v1.js dist/direct-reset-authority-v1.js \
  && cp dashboard/direct-interaction-guard-v3.js dist/direct-interaction-guard-v3.js \
  && cp dashboard/direct-strategy-persistence-v1.js dist/direct-strategy-persistence-v1.js \
  && cp dashboard/direct-continuity-checkpoint-v1.js dist/direct-continuity-checkpoint-v1.js \
  && cp dashboard/direct-ui-cleanup-v1.js dist/direct-ui-cleanup-v1.js \
  && cp dashboard/direct-builder-loaded-v2.js dist/direct-builder-loaded-v2.js \
  && cp dashboard/direct-demo-reset-router-v1.js dist/direct-demo-reset-router-v1.js \
  && cp dashboard/direct-transaction-ledger-v6.js dist/direct-transaction-ledger-v6.js \
  && cp dashboard/direct-run-panel-authority-v6.js dist/direct-run-panel-authority-v6.js \
  && cp dashboard/mobile-layout-authority-v1.js dist/mobile-layout-authority-v1.js \
  && cp dashboard/run-panel-usability-v1.js dist/run-panel-usability-v1.js \
  && cp dashboard/scheduler-v2-ui.js dist/scheduler-v2-ui.js \
  && node scripts/finalize-scheduler-v2.mjs \
  && node --check dist/final-premium-6f3.js \
  && node --check dist/final-ui-shell-v2.js \
  && node --check dist/direct-pip-precision-v1.js \
  && node --check dist/direct-financial-fence-v1.js \
  && node --check dist/direct-socket-control-v1.js \
  && node --check dist/direct-hard-stop-fence-v1.js \
  && node --check dist/direct-reset-authority-v1.js \
  && node --check dist/direct-interaction-guard-v3.js \
  && node --check dist/direct-strategy-persistence-v1.js \
  && node --check dist/direct-continuity-checkpoint-v1.js \
  && node --check dist/direct-ui-cleanup-v1.js \
  && node --check dist/direct-builder-loaded-v2.js \
  && node --check dist/direct-demo-reset-router-v1.js \
  && node --check dist/direct-transaction-ledger-v6.js \
  && node --check dist/direct-run-panel-authority-v6.js \
  && node --check dist/mobile-layout-authority-v1.js \
  && node --check dist/run-panel-usability-v1.js \
  && node --check dist/scheduler-v2-ui.js \
  && node -e "const fs=require('fs');const p='dist/index.html';let h=fs.readFileSync(p,'utf8');const scripts=['<script src=\"/direct-pip-precision-v1.js?v=20260818-direct-pip-v1\" defer></script>','<script src=\"/direct-financial-fence-v1.js?v=20260818-direct-fence-v2\" defer></script>','<script src=\"/direct-socket-control-v1.js?v=20260818-direct-socket-v1\" defer></script>','<script src=\"/direct-hard-stop-fence-v1.js?v=20260818-browser-hard-stop-v1\" defer></script>','<script src=\"/direct-reset-authority-v1.js?v=20260818-reset-authority-v1\" defer></script>','<script src=\"/direct-interaction-guard-v3.js?v=20260818-interaction-v3\" defer></script>','<script src=\"/deriv-direct-execution-v2.js?v=20260818-browser-direct-v6b\" defer></script>','<script src=\"/direct-strategy-persistence-v1.js?v=20260818-direct-persist-v1\" defer></script>','<script src=\"/direct-continuity-checkpoint-v1.js?v=20260818-direct-continuity-v2-split\" defer></script>','<script src=\"/direct-ui-cleanup-v1.js?v=20260818-direct-cleanup-v1\" defer></script>','<script src=\"/direct-builder-loaded-v2.js?v=20260818-builder-loaded-v2\" defer></script>','<script src=\"/direct-runtime-ux-v4.js?v=20260818-runtime-ux-v6\" defer></script>','<script src=\"/direct-demo-reset-router-v1.js?v=20260818-demo-reset-router-v1\" defer></script>','<script src=\"/direct-transaction-ledger-v6.js?v=20260818-unified-ledger-v9\" defer></script>','<script src=\"/direct-run-panel-authority-v6.js?v=20260818-scheduler-start-stop-v2\" defer></script>','<script src=\"/mobile-layout-authority-v1.js?v=20260818-mobile-layout-v1\" defer></script>','<script src=\"/run-panel-usability-v1.js?v=20260818-run-panel-usability-v2\" defer></script>','<script src=\"/scheduler-v2-ui.js?v=20260818-scheduler-v2-ui-1\" defer></script>'];for(const s of scripts){if(!h.includes(s))h=h.replace('</body>',s+'\\n</body>');}fs.writeFileSync(p,h);"

FROM nginx:1.27-alpine AS frontend

COPY deploy/nginx/frontend-container.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=12 \
  CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
