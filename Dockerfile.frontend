FROM node:22-alpine AS build

WORKDIR /app

COPY package.json ./
RUN npm install --ignore-scripts --no-audit --no-fund

COPY dashboard ./dashboard
COPY scripts/build-vps.mjs ./scripts/build-vps.mjs
COPY scripts/export-deriv-quill-icons-v2.mjs ./scripts/export-deriv-quill-icons-v2.mjs

ARG PUBLIC_ORIGIN=https://derivadmin.site
ARG PUBLIC_TESTING_FREE_ACCESS=true
ENV PUBLIC_ORIGIN=${PUBLIC_ORIGIN}
ENV PUBLIC_TESTING_FREE_ACCESS=${PUBLIC_TESTING_FREE_ACCESS}

RUN node scripts/build-vps.mjs
# Hybrid execution frontend. Live/manual trading is browser <-> Deriv directly;
# the VPS remains a control plane for OTP bootstrap, scheduling and offline takeover.
# The old single-run controller is intentionally no longer injected because it
# polled backend lifecycle state and could fight the browser-owned Run state.
RUN cp dashboard/deriv-direct-execution-v1.js dist/deriv-direct-execution-v1.js \
  && cp dashboard/direct-strategy-persistence-v1.js dist/direct-strategy-persistence-v1.js \
  && cp dashboard/direct-ui-cleanup-v1.js dist/direct-ui-cleanup-v1.js \
  && node -e "const fs=require('fs');const p='dist/index.html';let h=fs.readFileSync(p,'utf8');const scripts=['<script src=\"/deriv-direct-execution-v1.js?v=20260818-browser-direct-v1\" defer></script>','<script src=\"/direct-strategy-persistence-v1.js?v=20260818-direct-persist-v1\" defer></script>','<script src=\"/direct-ui-cleanup-v1.js?v=20260818-direct-cleanup-v1\" defer></script>'];for(const s of scripts){if(!h.includes(s))h=h.replace('</body>',s+'\\n</body>');}fs.writeFileSync(p,h);"

FROM nginx:1.27-alpine AS frontend

COPY deploy/nginx/frontend-container.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=12 \
  CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
