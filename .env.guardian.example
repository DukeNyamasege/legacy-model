# Copy to /etc/legacy-model-guardian.env and chmod 600.
# Never commit the real values or paste them into chat.

GUARDIAN_REPO_DIR=/root/legacy-model
GUARDIAN_STATE_DIR=/var/lib/legacy-model-guardian
GUARDIAN_COMPOSE_FILES=docker-compose.yml,docker-compose.vps.yml

# OpenAI API — required. The service uses the Responses API.
OPENAI_API_KEY=
GUARDIAN_DIAGNOSIS_MODEL=gpt-5.4-mini
GUARDIAN_CODING_MODEL=gpt-5.3-codex
GUARDIAN_REVIEWER_MODEL=gpt-5.4-mini
# Includes diagnosis, coding, independent review and structured-output fallbacks.
GUARDIAN_MAX_AI_CALLS_PER_DAY=30

# Dedicated private Telegram bot — required.
# Use a separate bot from the public/channel publisher.
GUARDIAN_TELEGRAM_BOT_TOKEN=
GUARDIAN_TELEGRAM_ADMIN_CHAT_ID=

# Monitoring cadence.
GUARDIAN_SCAN_INTERVAL_SECONDS=20
GUARDIAN_LOG_LOOKBACK_SECONDS=90
GUARDIAN_MAXIMUM_LOG_LINES=240
GUARDIAN_STRATEGY_REVIEW_INTERVAL_SECONDS=21600

# SAFE COMMISSIONING DEFAULTS.
# The Guardian monitors, diagnoses and sends private proposals. After approval it
# may create, test, review and push a normal commit to Git main only. It has no
# authority to update or deploy the VPS; Duke performs VPS updates manually.
GUARDIAN_ALLOW_MAIN_PUSH=false
# Retained for compatibility and safety checks. The runtime ignores this setting
# and permanently forces automatic VPS deployment off.
GUARDIAN_AUTO_DEPLOY=false
GUARDIAN_DRY_RUN=true

GUARDIAN_HEALTH_URL=http://127.0.0.1:8080/health/ready
GUARDIAN_METRICS_URL=http://127.0.0.1:8080/metrics/summary?mode=demo
GUARDIAN_LOG_LEVEL=INFO
