# Caddyfile - HTTPS reverse proxy for the Contabo backend only.
# Netlify serves the browser UI at derivadmin.site.
# Contabo exposes only FastAPI REST/OAuth and the signed realtime WebSocket.

api.derivadmin.site {
    encode zstd gzip

    reverse_proxy 127.0.0.1:8080

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}
