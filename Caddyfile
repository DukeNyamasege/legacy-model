# Caddyfile - HTTPS reverse proxy for the dedicated backend only.
#
# The browser UI is served by Netlify. This host exposes FastAPI REST/OAuth and
# the signed realtime WebSocket; it does not serve the production frontend.
#
# Before starting Caddy, set BACKEND_DOMAIN to the DNS name pointing at the new
# VPS, for example: api.example.com

{$BACKEND_DOMAIN:api.example.com} {
    encode zstd gzip

    reverse_proxy 127.0.0.1:8080

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}
