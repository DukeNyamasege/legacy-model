# Full-VPS production edge for derivadmin.site.
# Caddy terminates HTTPS and routes the same-origin browser application to the
# loopback-only frontend/API containers. The legacy api.derivadmin.site hostname
# remains available during migration/rollback.

derivadmin.site {
    encode zstd gzip

    # Browser REST calls are generated as /api/<backend-path>. handle_path strips
    # /api before forwarding so FastAPI continues to expose /me, /health, etc.
    handle_path /api/* {
        reverse_proxy 127.0.0.1:8080
    }

    # OAuth and realtime paths are already backend-native and must be preserved.
    handle /oauth/* {
        reverse_proxy 127.0.0.1:8080
    }

    handle /ws/* {
        reverse_proxy 127.0.0.1:8080
    }

    handle /backend-health {
        rewrite * /health/frontend-backend
        reverse_proxy 127.0.0.1:8080
    }

    # Everything else is the static dashboard/SPA frontend container.
    handle {
        reverse_proxy 127.0.0.1:8081
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    }
}

# Keep the existing backend hostname alive during the migration window and for
# diagnostics. New browser traffic should use same-origin derivadmin.site/api/*.
api.derivadmin.site {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
    }
}
