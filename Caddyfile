# Caddyfile - HTTPS reverse proxy for the Deriv bot dashboard and API
#
# Install Caddy on Ubuntu:
#   sudo apt install -y caddy
#
# Copy this file to /etc/caddy/Caddyfile, then:
#   sudo systemctl restart caddy
#
# Caddy automatically provisions and renews Let's Encrypt certificates.

www.derivadmin.site {
    redir https://derivadmin.site{uri} permanent
}

derivadmin.site {
    encode zstd gzip
    reverse_proxy 10.89.0.10:8080

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}
